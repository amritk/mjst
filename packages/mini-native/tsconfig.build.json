{
  "extends": ["./tsconfig.json", "../../tsconfig.build.json"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // The build emits every host, including the DOM one, so this pass needs the
    // browser types — the DOM-free rule is a type-check invariant (see
    // `tsconfig.json` / `tsconfig.dom.json`), not an emit one. `types` is
    // re-asserted because the shared `../../tsconfig.build.json` (applied last
    // in `extends`) resets `lib`/`types` back to the Node-only defaults.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@amritk/mini-native"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
