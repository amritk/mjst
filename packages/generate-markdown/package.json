{
  "name": "@amritk/generate-markdown",
  "version": "0.4.9",
  "description": "Generate markdown documentation from JSON Schemas.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "imports": {
    "#helpers/*": "./src/helpers/*.ts",
    "#reference/*": "./src/reference/*.ts",
    "#table/*": "./src/table/*.ts",
    "#types/*": "./src/types/*.ts"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "amritk",
  "keywords": [
    "json-schema",
    "markdown",
    "documentation",
    "mjst"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/mjst.git",
    "directory": "packages/generate-markdown"
  },
  "homepage": "https://github.com/amritk/mjst/tree/main/packages/generate-markdown#readme",
  "bugs": {
    "url": "https://github.com/amritk/mjst/issues"
  },
  "files": [
    "dist",
    "AI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f && node ../../scripts/strip-comments.mjs",
    "generate-fixtures": "bun --conditions development scripts/update-fixtures.ts",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs",
    "types:check": "tsgo -p . --noEmit",
    "test": "NODE_ENV=production vitest run --root ../.. generate-markdown"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
