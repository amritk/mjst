{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "#helpers/*": ["./src/helpers/*"],
      "#reference/*": ["./src/reference/*"],
      "#table/*": ["./src/table/*"],
      "#types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
