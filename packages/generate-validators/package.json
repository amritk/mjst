{
  "name": "@amritk/generate-validators",
  "version": "0.15.1",
  "description": "Generate TypeScript validation functions from JSON Schemas.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "amritk",
  "keywords": [
    "json-schema",
    "typescript",
    "validator",
    "validation",
    "code-generation",
    "mjst"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/mjst.git",
    "directory": "packages/generate-validators"
  },
  "homepage": "https://github.com/amritk/mjst/tree/main/packages/generate-validators#readme",
  "bugs": {
    "url": "https://github.com/amritk/mjst/issues"
  },
  "files": [
    "dist",
    "AI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f && node ../../scripts/strip-comments.mjs",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs",
    "types:check": "tsgo -p . --noEmit",
    "test": "NODE_ENV=production vitest run --root ../.. generate-validators",
    "prebench": "bun run --filter='@amritk/helpers' build && bun run build",
    "bench": "bun --conditions development ./bench/run.ts",
    "prebench:node": "bun run --filter='@amritk/helpers' build && bun run build",
    "bench:node": "node ./bench/run.ts",
    "bench:moltar": "bun --conditions development ./bench/moltar.ts",
    "bench:moltar:leaderboard": "bun --conditions development ./bench/moltar-leaderboard.ts"
  },
  "imports": {
    "#generators/*": "./src/generators/*.ts"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "json-schema-typed": "catalog:",
    "@amritk/helpers": "workspace:*"
  },
  "devDependencies": {
    "@amritk/generate-parsers": "workspace:*",
    "@amritk/runtime-validators": "workspace:*",
    "@ryoppippi/unplugin-typia": "^2.6.5",
    "@scalar/openapi-parser": "^0.26.1",
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "benny": "^3.7.1",
    "typia": "^12.1.1",
    "zod": "^4.4.3"
  }
}
