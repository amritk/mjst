{
  "name": "@amritk/helpers",
  "version": "0.18.0",
  "description": "Shared utilities for the mjst code generation ecosystem.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "amritk",
  "keywords": [
    "json-schema",
    "typescript",
    "mjst"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/mjst.git",
    "directory": "packages/helpers"
  },
  "homepage": "https://github.com/amritk/mjst/tree/main/packages/helpers#readme",
  "bugs": {
    "url": "https://github.com/amritk/mjst/issues"
  },
  "files": [
    "dist",
    "src/has-ref.ts",
    "src/is-object.ts",
    "src/validate-array.ts",
    "src/validate-record.ts",
    "AI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f && node ../../scripts/strip-comments.mjs",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs",
    "types:check": "tsgo -p . --noEmit",
    "test": "NODE_ENV=production vitest run --root ../.. helpers"
  },
  "dependencies": {
    "json-schema-typed": "catalog:"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts"
      ]
    }
  }
}
