{
  "name": "@amritk/runtime-validators",
  "version": "0.13.0",
  "description": "Extremely fast, eval-free runtime JSON Schema validation. Interprets a schema you do not know ahead of time \u2014 no new Function, no build step, runs anywhere.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "amritk",
  "keywords": [
    "json-schema",
    "typescript",
    "validator",
    "validation",
    "runtime",
    "ajv",
    "fast",
    "mjst",
    "parser",
    "parse",
    "coercion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/mjst.git",
    "directory": "packages/runtime-validators"
  },
  "homepage": "https://github.com/amritk/mjst/tree/main/packages/runtime-validators#readme",
  "bugs": {
    "url": "https://github.com/amritk/mjst/issues"
  },
  "files": [
    "dist",
    "AI.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f && node ../../scripts/strip-comments.mjs",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs",
    "types:check": "tsgo -p . --noEmit",
    "test": "NODE_ENV=production vitest run --root ../.. runtime-validators",
    "prebench": "bun run build",
    "bench": "bun run ./bench/run.ts",
    "prebench:node": "bun run build",
    "bench:node": "node ./bench/run.ts",
    "bench:dynamic": "bun --conditions development ./bench/dynamic-refs.ts"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "development": "./src/parse/index.ts",
      "types": "./dist/parse/index.d.ts",
      "default": "./dist/parse/index.js"
    },
    "./metaschema": {
      "development": "./src/metaschema/index.ts",
      "types": "./dist/metaschema/index.d.ts",
      "default": "./dist/metaschema/index.js"
    }
  },
  "devDependencies": {
    "@amritk/helpers": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
